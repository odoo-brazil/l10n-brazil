<odoo>

    <record model="ir.ui.view" id="pos_invoice_cancel_reason_form_view">
        <field name="name">pos.invoice.cancel.reason.form (in l10n_br_pos)</field>
        <field name="model">pos.invoice.cancel.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="active" />
                    </group>
                </sheet>
                <div class="oe_chatter" />
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="pos_invoice_cancel_reason_search_view">
        <field name="name">pos.invoice.cancel.reason.search (in l10n_br_pos)</field>
        <field name="model">pos.invoice.cancel.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="pos_invoice_cancel_reason_tree_view">
        <field name="name">pos.invoice.cancel.reason.tree (in l10n_br_pos)</field>
        <field name="model">pos.invoice.cancel.reason</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="pos_invoice_cancel_reason_act_window">
        <field name="name">Invoice Cancel Reason</field>
        <field name="res_model">pos.invoice.cancel.reason</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="pos_invoice_cancel_reason_menu">
        <field name="name">Invoice Cancel Reason</field>
        <field name="parent_id" ref="point_of_sale.menu_pos_config_pos" />
        <field name="action" ref="pos_invoice_cancel_reason_act_window" />
        <field name="sequence" eval="16" />
    </record>

</odoo>
